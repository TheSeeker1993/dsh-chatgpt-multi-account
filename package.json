{
  "name": "dsh-chatgpt-multi-account",
  "version": "0.3.1",
  "description": "Multiple ChatGPT accounts for DeepSeek Harness: per-session routing, compact model picker and remaining quota tracking.",
  "author": "qixxby",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qixxby/dsh-chatgpt-multi-account.git"
  },
  "homepage": "https://github.com/qixxby/dsh-chatgpt-multi-account#readme",
  "bugs": {
    "url": "https://github.com/qixxby/dsh-chatgpt-multi-account/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.2-rc.2 <0.2.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "index.js",
    "client",
    "lib",
    "multi",
    "cordis.patch.yml",
    "locale/*.json",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "contract": "node scripts/check-contract.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --check index.js && node --check client/index.js && node --test test/*.test.js",
    "read": "node lib/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "chatgpt",
    "codex",
    "gpt",
    "openai-codex"
  ],
  "contributors": [
    {
      "name": "Clukay-Fun",
      "url": "https://github.com/Clukay-Fun"
    }
  ]
}
